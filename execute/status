#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG="$ROOT/config/defaults.env"
LOCAL_CONFIG="$ROOT/config/local.env"

set -a
[[ -f "$CONFIG" ]] && source "$CONFIG"
[[ -f "$LOCAL_CONFIG" ]] && source "$LOCAL_CONFIG"
set +a

echo "=== CHARACTER VOICE STATUS ==="
echo

ERRORS=0
CLONE_READY=1
DESIGN_READY=1

check() {
  local label="$1"
  local result="$2"

  if [[ "$result" == "ok" ]]; then
    printf '%-20s OK\n' "$label"
  else
    printf '%-20s ERROR: %s\n' "$label" "$result"
    ERRORS=$((ERRORS + 1))
  fi
}

echo "Shared"
echo "------"

if [[ -n "${QWEN_TTS_PYTHON:-}" ]]; then
  PYTHON="$QWEN_TTS_PYTHON"

  if [[ -x "$PYTHON" ]] || command -v "$PYTHON" >/dev/null 2>&1; then
    check "Python" "ok"
  else
    check "Python" "executable not found: $PYTHON"
    PYTHON=""
  fi
else
  check "Python" "QWEN_TTS_PYTHON is not configured"
  PYTHON=""
fi

if [[ -n "${OUTPUT_DIR:-}" ]]; then
  check "Output" "ok"
else
  check "Output" "OUTPUT_DIR is not configured"
fi

echo
echo "Clone"
echo "-----"

if [[ -n "${QWEN_TTS_MODEL:-}" ]]; then
  [[ -d "$QWEN_TTS_MODEL" ]] \
    && check "Model" "ok" \
    || {
      check "Model" "directory not found: $QWEN_TTS_MODEL"
      CLONE_READY=0
    }
else
  check "Model" "QWEN_TTS_MODEL is not configured"
  CLONE_READY=0
fi

if [[ -n "${REFERENCE_AUDIO:-}" ]]; then
  [[ -f "$REFERENCE_AUDIO" ]] \
    && check "Reference" "ok" \
    || {
      check "Reference" "file not found: $REFERENCE_AUDIO"
      CLONE_READY=0
    }
else
  check "Reference" "REFERENCE_AUDIO is not configured"
  CLONE_READY=0
fi

if [[ -n "${REFERENCE_TEXT:-}" ]]; then
  check "Transcript" "ok"
else
  check "Transcript" "REFERENCE_TEXT is not configured"
  CLONE_READY=0
fi

if [[ "$CLONE_READY" -eq 1 ]]; then
  echo "Ready:               YES"
else
  echo "Ready:               NO"
fi

echo
echo "Design"
echo "------"

if [[ -n "${QWEN_TTS_DESIGN_MODEL:-}" ]]; then
  [[ -d "$QWEN_TTS_DESIGN_MODEL" ]] \
    && check "VoiceDesign model" "ok" \
    || {
      check "VoiceDesign model" \
        "directory not found: $QWEN_TTS_DESIGN_MODEL"
      DESIGN_READY=0
    }
else
  check "VoiceDesign model" "QWEN_TTS_DESIGN_MODEL is not configured"
  DESIGN_READY=0
fi

if [[ "$DESIGN_READY" -eq 1 ]]; then
  echo "Ready:               YES"
else
  echo "Ready:               NO"
fi

if [[ -n "$PYTHON" ]]; then
  echo
  "$PYTHON" - <<'PY'
try:
    import torch
    print("torch:", torch.__version__)
    print("CUDA:", torch.cuda.is_available())
    if torch.cuda.is_available():
        print("GPU:", torch.cuda.get_device_name(0))
        print(
            "VRAM_GB:",
            round(
                torch.cuda.get_device_properties(0).total_memory / 1024**3,
                2,
            ),
        )
except Exception as e:
    print("torch check:", repr(e))

try:
    import qwen_tts
    print("qwen_tts:", qwen_tts.__file__)
except Exception as e:
    print("qwen_tts:", repr(e))
PY
fi

echo
if [[ "$CLONE_READY" -eq 1 || "$DESIGN_READY" -eq 1 ]]; then
  echo "Status: READY"
else
  echo "Status: NOT READY"
  exit 1
fi
