# Public defaults. Override these in config/local.env.

# Dedicated Python environment containing qwen_tts.
QWEN_TTS_PYTHON=python3

# Local Qwen3-TTS model directory.
QWEN_TTS_MODEL=<MODEL_DIR>/Qwen3-TTS-12Hz-1.7B-Base

# Private reference audio. Keep outside the public repository.
REFERENCE_AUDIO=<PRIVATE_REFERENCE_AUDIO>

# Generated audio destination.
OUTPUT_DIR=<OUTPUT_DIR>

# Optional runtime settings.
DEVICE=auto
DTYPE=auto
