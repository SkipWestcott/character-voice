#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEMPLATE="$ROOT/config/machine.example.env"
LOCAL="$ROOT/config/local.env"

if [[ -f "$LOCAL" ]]; then
  echo "Local configuration already exists:"
  echo "  $LOCAL"
  exit 0
fi

cp "$TEMPLATE" "$LOCAL"

echo "Created:"
echo "  $LOCAL"
echo
echo "Edit this file with your local Qwen3-TTS paths, then run:"
echo "  ./command/status"
